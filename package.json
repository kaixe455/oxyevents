    "astro-seo": "0.8.4",
    "flowbite": "3.1.2",
    "photoswipe": "5.4.4",
    "swiper": "12.0.2",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@vitest/ui": "4.0.18",
    "happy-dom": "20.6.3",
    "playwright": "1.58.2",
    "postcss-nesting": "13.0.2",
    "sharp": "0.34.5",
    "vitest": "4.0.18"
