{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": [
				"src/components/*"
			],
			"@layouts/*": [
				"src/layouts/*"
			],
			"@utils/*": [
				"src/utils/*"
			],
			"@buttons/*": [
				"src/components/buttons/*"
			],
			"@forms/*": [
				"src/components/forms/*"
			],
			"@modals/*": [
				"src/components/modals/*"
			]
		}
	}
}