<div
	id="formulario_entradas"
	class="hidden mt-6 bg-white text-black rounded-xl p-6 w-full shadow-xl"
>
	<form
		class="flex flex-col gap-6"
		onsubmit="event.preventDefault(); alert('Compra simulada');"
	>
		<div class="grid sm:grid-cols-2 gap-6">
			<div>
				<label for="nombre" class="font-semibold"> Nombre completo </label>
				<input
					id="nombre"
					name="nombre"
					type="text"
					required
					minlength="3"
					maxlength="50"
					placeholder="Ej. Laura Martínez"
					class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
				/>
			</div>
			<div>
				<label class="font-semibold">DNI</label>
				<div class="flex gap-2">
					<input
						type="number"
						name="dni_num"
						inputmode="numeric"
						required
						maxlength="8"
						minlength="8"
						placeholder="12345678"
						class="w-3/4 px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF] no-spinner"
					/>
					<input
						type="text"
						name="dni_letra"
						pattern="[A-Za-z]{1}"
						required
						maxlength="1"
						minlength="1"
						placeholder="A"
						class="w-1/4 px-4 py-2 text-center uppercase rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
					/>
				</div>
			</div>
		</div>

		<div class="grid sm:grid-cols-2 gap-6">
			<div>
				<label for="email" class="font-semibold"> Correo electrónico </label>
				<input
					id="email"
					name="email"
					type="email"
					required
					placeholder="email@ejemplo.com"
					class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
				/>
			</div>
			<div>
				<label for="telefono" class="font-semibold"> Teléfono </label>
				<input
					id="telefono"
					name="telefono"
					type="tel"
					required
					inputmode="tel"
					pattern="^[+]?[\d\s]{9,15}$"
					placeholder="+34 600 123 456"
					class="no-spinner w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
				/>
			</div>
		</div>

		<div class="grid sm:grid-cols-2 gap-6">
			<div>
				<label for="tipo" class="font-semibold"> Tipo de entrada </label>
				<select
					id="tipo"
					name="tipo"
					required
					class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
				>
					<option value="">Selecciona una opción</option>
					<option value="general">General</option>
					<option value="vip">VIP</option>
				</select>
			</div>
			<div>
				<label for="cantidad" class="font-semibold"> Cantidad </label>
				<input
					id="cantidad"
					name="cantidad"
					type="number"
					min="1"
					max="10"
					value="1"
					required
					class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1AA9FF]"
				/>
			</div>
		</div>

		<div class="flex justify-center">
			<button
				type="submit"
				class="bg-[#1AA9FF] text-white font-bold px-10 py-3 rounded-xl text-lg shadow-lg transition-transform hover:scale-105 hover:shadow-xl"
			>
				Obtén tu entrada
			</button>
		</div>
	</form>
</div>
