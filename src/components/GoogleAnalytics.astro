---
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---
{GA_ID && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      // dataLayer y gtag
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }

      // Consent Mode v2: denegar por defecto
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      // Inicializa gtag
      gtag('js', new Date());

      // Si ya hay consentimiento almacenado, concédelo y configura GA
      try {
        const stored = localStorage.getItem('consent'); // 'granted' | 'denied' | null
        if (stored === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            analytics_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
          });
          gtag('config', GA_ID, { anonymize_ip: true });
          gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
        }
      } catch {}

      // Escucha la decisión del banner
      window.addEventListener('consent-changed', (e) => {
        const granted = e.detail === 'granted';
        gtag('consent', 'update', {
          ad_storage: granted ? 'granted' : 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          ad_user_data: granted ? 'granted' : 'denied',
          ad_personalization: granted ? 'granted' : 'denied',
        });
        if (granted) {
          gtag('config', GA_ID, { anonymize_ip: true });
          gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
        }
      });
    </script>
  </>
)}