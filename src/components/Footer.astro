---
import Logo from "@components/Logo.astro";
---

<div id="contenido_footer" class="flex flex-col items-center justify-center bg-[#1a191d] px-8 py-6 w-full lg:h-[520px]">
    <div id="arriba_footer" class="flex flex-col items-center w-full gap-8 md:gap-12 lg:flex-row lg:items-start lg:justify-center lg:gap-[8vh] xl:gap-[12vh]">
        <div class="menus_footer flex flex-col gap-4 min-w-[200px] text-center lg:text-left">
            <span class="text-[#1AA9FF] font-bold text-xl lg:text-[22px] md:text-[35px]">OXYGENGAMING</span>
            <div class="info_footer flex flex-col gap-3">
                <a href="/about-us" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">SOBRE NOSOTROS</a>
                <a href="/eventos" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">EVENTOS</a>
                <a href="/clientes" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF]  md:text-[25px] lg:text-[18px]">CLIENTES</a>
                <a href="/contacto" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">CONTACTO</a>
            </div>
        </div>

        <div class="menus_footer flex flex-col gap-4 min-w-[200px] text-center lg:text-left">
            <span class="text-[#1AA9FF] font-bold text-xl lg:text-[22px] md:text-[35px]">CATÁLOGO</span>
            <div class="info_footer flex flex-col gap-3">
                <a href="/catalogo/#gaming" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">TECNOLOGÍA</a>
                <a href="/catalogo/#sports" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">DEPORTE</a>
                <a href="/catalogo/#ponencias" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">PONENCIAS</a>
            </div>
        </div>

        <div class="menus_footer flex flex-col gap-4 min-w-[200px] text-center lg:text-left">
            <span class="text-[#1AA9FF] font-bold text-xl lg:text-[22px] md:text-[35px]">POLÍTICAS</span>
            <div class="info_footer flex flex-col gap-3">
                <a href="https://oxygengaming.es/aviso-legal/" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">AVISO LEGAL</a>
                <a href="https://oxygengaming.es/politica-de-privacidad/" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">PRIVACIDAD</a>
                <a href="https://oxygengaming.es/politica-de-cookies/" class="text-[#b0b0b0] font-bold transition-colors duration-300 hover:text-[#1AA9FF] md:text-[25px] lg:text-[18px]">COOKIES</a>
            </div>
        </div>

        <div id="redes_sociales" class="flex flex-col items-center text-center">
            <a href="https://oxygengaming.es/">
                <img id="logo_footer" src="/svgs/logo/o2glogo.svg" alt="Oxygen Gaming Logo" class="w-[150px] mb-3.5"/>
            </a>
            <div class="social-links flex gap-4">
                <a href="https://twitter.com/GamingOxygen" target="_blank" aria-label="Twitter de Oxygen Gaming" class="flex justify-center items-center text-white bg-[#222] border-2 border-[#1AA9FF] w-10 h-10 rounded-full transition-all duration-300 hover:text-[#1AA9FF] text-[20px] md:w-[70px] md:h-[70px] md:text-[30px] lg:w-[50px] lg:h-[50px] lg:text-[20px]">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://instagram.com/GamingOxygen" target="_blank" aria-label="Instagram de Oxygen Gaming" class="flex justify-center items-center text-white bg-[#222] border-2 border-[#1AA9FF] w-10 h-10 rounded-full transition-all duration-300 hover:text-[#e4405f] text-[20px] md:w-[70px] md:h-[70px] md:text-[30px] lg:w-[50px] lg:h-[50px] lg:text-[20px]">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="https://www.tiktok.com/@oxygengaming.tv?lang=es" target="_blank" aria-label="TikTok de Oxygen Gaming" class="flex justify-center items-center text-white bg-[#222] border-2 border-[#1AA9FF] w-10 h-10 rounded-full transition-all duration-300 hover:text-[#69c9d0] text-[20px] md:w-[70px] md:h-[70px] md:text-[30px] lg:w-[50px] lg:h-[50px] lg:text-[20px]">
                    <i class="fab fa-tiktok"></i>
                </a>
                <a href="https://discord.gg/Udsstfpeze" target="_blank" aria-label="Discord de Oxygen Gaming" class="flex justify-center items-center text-white bg-[#222] border-2 border-[#1AA9FF] w-10 h-10 rounded-full transition-all duration-300 hover:text-[#7289da] text-[20px] md:w-[70px] md:h-[70px] md:text-[30px] lg:w-[50px] lg:h-[50px] lg:text-[20px]">
                    <i class="fab fa-discord"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Logos Section -->
    <div id="logos_footer" class="flex flex-col items-center w-full border-t border-[#333] pt-12 mt-12 md:pt-16 md:mt-16 lg:pt-20 lg:mt-20 pb-8">
        <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 lg:gap-16 w-full px-4">
            <!-- IVF-GVA Logo -->
            <div class="flex justify-center w-full md:w-auto">
                <img src="/imgs/logo_ivf_gva.svg" alt="Logo IVF-GVA-UE" class="h-20 md:h-24 lg:h-28 w-auto object-contain"/>
            </div>
            
            <!-- Conselleria Logo -->
            <div class="flex justify-center w-full md:w-auto">
                <img src="/imgs/logo_conselleria.svg" alt="Logo Conselleria de Innovación Industria Comercio y Turismo" class="h-20 md:h-24 lg:h-28 w-auto object-contain"/>
            </div>
        </div>
    </div>
</div>
