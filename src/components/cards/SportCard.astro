---
const { text, img } = Astro.props;
---
<a href={`/catalogo/sports/${text}`} class="flex-grow">
  <div
    class="bg-[#11123b] min-[568px]:w-[110vh] min-[568px]:h-[95vh] sm:h-[80vh] rounded-xl text-center py-2 border border-[#212266] hover:contrast-75 transition-all duration-300 w-[32vh] lg:w-[40vh] lg:h-[45vh] h-[40vh] max-[320px]:w-[40vh] max-[320px]:h-[50vh] md:w-full md:h-[25rem] xl:w-[55vh]  flex flex-col"
  >
      <div class="w-full h-[30vh] min-[568px]:h-[70vh] sm:h-[70vh] md:h-full overflow-hidden">
        <img
          class="rounded-t-lg w-full h-full object-cover"
          src={`/catalogo/sports/${img}.webp`}
          alt={text}
        />
      </div>
      <h5 class="max-[320px]:mt-[20px] min-[568px]:mt-[30px] font-syne-bold text-[23px] lg:text-xl lg:mb-[20px] md:text-[25px] md:mt-[30px] sm:mt-[30px] mb-[20px] text-white flex items-center justify-center h-[10vh]">
        {text}
    </h5>
  </div>
</a>
