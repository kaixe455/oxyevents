---
const { name, img } = Astro.props;
---

<div
  class="min-w-full rounded-lg flex items-center justify-center p-2 hover:contrast-75 transition-all duration-300"
>
  <img
    class="rounded-lg h-[7rem] w-[10rem] border-[1px] border-[orange]"
    src=`sponsors/${img}.webp`
    alt={name}
    title={name}
  />
</div>
