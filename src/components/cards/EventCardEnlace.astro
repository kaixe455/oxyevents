---
import EventsPicsModal from "@components/modals/EventsPicsModal.astro";
const { name, img, date, description, images } = Astro.props;
---

<div id="tarjeta_activar" class="flex items-center justify-center"> 
  <img
  class="rounded-t-lg aspect-square hover:animate-[pulse_1s_ease-in-out_1] transition-all duration-500 h-[55vh] lg:h-[60vh] min-[568px]:h-[110vh] min-[568px]:w-[80vh]  sm:h-[110vh] md:h-[25rem] md:w-[30vh] lg:w-[50vh]"
  src={`/events/${img}`}
  alt={name}
  />
</div>
<EventsPicsModal images={images} />