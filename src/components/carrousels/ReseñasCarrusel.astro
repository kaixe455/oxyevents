---
// RatingStars sigue siendo usado
import RatingStars from "@components/sections/RatingStars.astro";

const resenas = [
  {
    texto:
      "Oxygen Gaming aportó profesionalidad, innovación y diversión, creando un evento inolvidable para nuestra comunidad",
    autor: "Icíar Valero, coordinadora de juventud del ayuntamiento Alcalà de Xivert.",
    calificacion: 5,
  },
  {
    texto:
      "Entretenimiento, movimiento y diversión virtual",
    autor: "Lidia Gargallo, técnica de juventud de la Mancomunidad Espadán-Mijares.",
    calificacion: 5,
  },
  {
    texto:
      "Oxygen Gaming aportó profesionalidad, innovación y diversión, creando un evento inolvidable para nuestra comunidad",
    autor: "Icíar Valero, coordinadora de juventud del ayuntamiento Alcalà de Xivert.",
    calificacion: 5,
  },
];
---

<div class="resenas-container">
  {resenas.map((resena) => (
    <div class="resena-card">
      <div class="resena-content">
        <RatingStars rating={resena.calificacion} />
        <p class="resena-text">"{resena.texto}"</p>
        <p class="resena-autor">- {resena.autor}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .resenas-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    padding: 2rem;
    justify-items: center;
  }

  .resena-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    max-width: 400px;
    width: 100%;
  }

  .resena-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 20px rgba(0,0,0,0.15);
  }

  .resena-content {
    text-align: center;
  }

  .resena-text {
    font-style: italic;
    color: #1aa9ff;
    margin: 1rem 0;
  }

  .resena-autor {
    font-weight: bold;
    color: #333;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .resena-card {
      padding: 1rem;
    }

    .resena-text {
      font-size: 0.95rem;
    }

    .resena-autor {
      font-size: 0.8rem;
    }
  }
</style>
