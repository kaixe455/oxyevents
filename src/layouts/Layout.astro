---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import GoogleAnalytics from "@components/GoogleAnalytics.astro";
import { SEO } from "astro-seo";
import GAConsentBanner from "@components/consent/GAConsentBanner.astro";

interface Props {
	title: string;
	description?: string;
}

const defaultDescription =
	"Organizamos eventos gaming, torneos eSports y eventos deportivos con simuladores VR. Tecnología, diversión y deporte en un solo lugar. ¡Contáctanos ya!";

const excelDescriptionsByPath: Record<string, string> = {
	"/": "Organizamos eventos gaming, torneos eSports y eventos deportivos con simuladores VR. Tecnología, diversión y deporte en un solo lugar. ¡Contáctanos ya!",
	"/about-us":
		"Líder en eventos gaming y tecnológicos. Promovemos la buena praxis en eSports con simuladores ICAROS y experiencias de realidad virtual. ¡Conócenos!",
	"/eventos":
		"Creamos experiencias únicas que combinan eSports, deporte y realidad virtual. Simulador de vuelo y actividades interactivas. ¡Solicita tu evento!",
	"/catalogo":
		"Catálogo con simulador de Vuelo, Conducción PC y VR. Encuentra equipamento para eventos tecnológicos y deportivos en Valencia, Tarragona o Zaragoza.",
};

const { title, description } = Astro.props;
const currentPath = Astro.url?.pathname?.replace(/\/$/, "") || "/";
const currentUrl = Astro.url?.toString();
const resolvedDescription =
	description ?? excelDescriptionsByPath[currentPath] ?? defaultDescription;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={resolvedDescription} />
		<meta name="viewport" content="width=device-width" />
		{currentUrl && <link rel="canonical" href={currentUrl} />}
		<link rel="icon" type="image/svg+xml" href="../../svgs/logo/o2glogo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- No quitar lo de abajo -->
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
			integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<SEO
			title={title}
			description={resolvedDescription}
			openGraph={{
				basic: {
					title,
					type: "website",
					image:
						"https://oxygengaming.es/wp-content/uploads/2022/07/logolight.png",
				},
			}}
			twitter={{
				creator: "@angelangulo95",
			}}
			extend={{
				meta: [
					{
						property: "og:site_name",
						content: "Oxygen Gaming",
					},
					currentUrl
						? {
								property: "og:url",
								content: currentUrl,
							}
						: null,
					{
						name: "twitter:image",
						content:
							"https://oxygengaming.es/wp-content/uploads/2022/07/logolight.png",
					},
					{
						name: "twitter:card",
						content: "summary_large_image",
					},
					{
						name: "twitter:title",
						content: title,
					},
					{
						name: "twitter:description",
						content: resolvedDescription,
					},
				].filter(Boolean),
			}}
		/>
		<GoogleAnalytics />
	</head>
	<body class="bg-[#1AA9FF] overflow-x-hidden">
		<Header />
		<slot />
		<Footer />
		<script src="../../node_modules/flowbite/dist/flowbite.min.js"></script>
		<style is:global>
			@font-face {
				font-family: "Syne-Regular";
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url("/fonts/Syne-Regular.woff2") format("woff2");
			}
			@font-face {
				font-family: "Syne-Bold";
				font-style: normal;
				font-weight: 700;
				font-display: swap;
				src: url("/fonts/Syne-Bold.woff2") format("woff2");
			}
			@font-face {
				font-family: "Syne-Medium";
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url("/fonts/Syne-Medium.woff2") format("woff2");
			}
			@font-face {
				font-family: "GeneralSans-Regular";
				font-style: normal;
				font-weight: 400;
				font-display: swap;
				src: url("/fonts/GeneralSans-Regular.woff2") format("woff2");
			}
			@font-face {
				font-family: "GeneralSans-Bold";
				font-style: normal;
				font-weight: 700;
				font-display: swap;
				src: url("/fonts/GeneralSans-Bold.woff2") format("woff2");
			}
			@font-face {
				font-family: "GeneralSans-Medium";
				font-style: normal;
				font-weight: 500;
				font-display: swap;
				src: url("/fonts/GeneralSans-Medium.woff2") format("woff2");
			}
		</style>
		<GAConsentBanner />
	</body>
</html>
