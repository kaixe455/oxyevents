---
import Layout from "@layouts/Layout.astro";
import EventCardEnlace from "@components/cards/EventCardLinked.astro";
import { events } from "@components/EventsList.astro";
import { parseDate } from "@utils/dates";
import ReturnButton from "@buttons/ReturnButton.astro";
import TicketingForm from "@forms/TicketingForm.astro";
import EventImgModal from "@modals/EventImgModal.astro";

const { name } = Astro.params;
const item = events.find((i) => i.name === name);

const eventDate = parseDate(item?.date);
const isFuture = eventDate && eventDate > new Date();
---

<Layout
	title={item ? item.name : "No encontrado"}
	description={item?.description}
>
	<main class="text-white relative my-16">
		<div
			class="gap-[50px] lg:gap-[10vh] mt-[100px] lg:mt-0 w-full bg-[#1AA9FF] flex flex-col sm:flex-row md:flex-row justify-center items-center md:h-[600px] p-8"
		>
			<!-- Tarjeta clickeable -->
			<div id="tarjeta_activar" class="cursor-pointer">
				<EventCardEnlace
					name={item.name}
					img={item.img}
					alt={item.alt}
					date={item.date}
				/>
			</div>

			<!-- Info y botones -->
			<div
				class="flex flex-col justify-center text-white text-justify text-[18px] w-full md:w-1/2"
			>
				<h3 class="font-bold text-[25px]">
					<i class="fa-solid fa-location-dot"></i>
					{item.name}
				</h3>
				<span class="font-bold text-[20px] italic"
					><i class="fa-solid fa-calendar-days"></i> {item.date}</span
				>
				<span class="lg:w-[80%]">{item.description}</span>

				<div class="flex gap-1">
					<ReturnButton />
					{
						isFuture && (
							<div class="w-[16rem] flex flex-col items-center justify-center mt-[30px]">
								<button
									id="mostrar_formulario"
									class="relative z-10 inline-flex items-center px-10 py-2 text-lg font-bold text-blue-500 bg-white rounded shadow-lg transform transition-all duration-300 hover:scale-105 hover:shadow-2xl"
								>
									Obtén tu entrada
								</button>
							</div>
						)
					}
				</div>

				{isFuture && <TicketingForm />}
			</div>
		</div>

		<!-- MODAL -->
		<EventImgModal item={item} />
	</main>

	<!-- Scripts -->
	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const tarjeta = document.getElementById("tarjeta_activar");
			const modal = document.getElementById("imagen_zoom");
			const botonFormulario = document.getElementById("mostrar_formulario");
			const contenedorFormulario = document.getElementById(
				"formulario_entradas",
			);

			tarjeta?.addEventListener("click", () => {
				modal?.classList.remove("hidden");
			});

			botonFormulario?.addEventListener("click", () => {
				contenedorFormulario?.classList.toggle("hidden");
				if (botonFormulario && contenedorFormulario) {
					botonFormulario.textContent = contenedorFormulario.classList.contains(
						"hidden",
					)
						? "Obtén tu entrada"
						: "Ocultar";
				}
			});
		});
	</script>

	<!-- Estilos adicionales -->
	<style>
		input.no-spinner::-webkit-outer-spin-button,
		input.no-spinner::-webkit-inner-spin-button {
			-webkit-appearance: none;
			margin: 0;
		}
		input.no-spinner[type="number"],
		input.no-spinner[type="tel"] {
			-moz-appearance: textfield;
		}
	</style>
</Layout>
