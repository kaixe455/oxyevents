---
import Layout from "@layouts/Layout.astro";
import ClientPageSection from "@components/sections/ClientPageSection.astro";
import Section from "@components/Section.astro";
---

<Layout
	title="Oxygen Gaming Eventos - Nuestros clientes"
	description="Descubre las marcas e instituciones que han confiado en Oxygen Gaming para sus eventos gaming, deportivos y tecnológicos."
>
	<main class="text-[white]">
		<section class="mt-[30px] md:mt-[0px]">
			<div
				class="w-full flex flex-col items-center justify-center xl:h-[20vh] sm:h-[80vh] md:h-[50vh] h-[50vh]"
			>
				<Section title="Nuestros Clientes" />
			</div>
		</section>

		<ClientPageSection />
	</main>
</Layout>
